{
    "name": "sala/console",
    "description": "Console commands for Sala Framework (make, migrate, db, serve)",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Sala\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sala\\Console\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "psy/psysh": "^0.12",
        "symfony/console": "^7.0",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/container": "^10.0|^11.0|^12.0",
        "illuminate/config": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "fakerphp/faker": "^1.21",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.12"
        }
    },
    "bin": [
        "bin/console"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}